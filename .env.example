# ─────────────────────────────────────────────────────────────────────────────
# FanTicket Hub — environment template  (roadmap §10)
#
#   cp .env.example .env.local
#
# Phase-gated: only fill what the current phase needs. Missing keys never crash
# the app — providers fall back to Mock Mode (see README "Mock Mode").
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase 0 — required ───────────────────────────────────────────────────────
DATABASE_URL=                    # Neon Postgres connection string
BETTER_AUTH_SECRET=              # 32+ byte random string: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# ── Phase 1 — providers ──────────────────────────────────────────────────────
SEATGEEK_CLIENT_ID=              # seatgeek.com API form
SEATGEEK_CLIENT_SECRET=
TICKETMASTER_API_KEY=            # developer.ticketmaster.com (instant, free)

# ── Phase 1 — affiliate tracking IDs (empty until partner approves) ──────────
SEATGEEK_AFFILIATE_ID=           # SeatGeek partner program
STUBHUB_AFFILIATE_ID=            # Impact Radius
VIVIDSEATS_AFFILIATE_ID=         # Impact Radius
TICKPICK_AFFILIATE_ID=
GAMETIME_AFFILIATE_ID=           # Impact Radius
TICKETMASTER_AFFILIATE_ID=       # CJ Affiliate

# ── Phase 1 — email, jobs, cache ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="FanTicket Hub <alerts@example.com>"
QSTASH_TOKEN=
CRON_SECRET=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Force Mock Mode for a provider that HAS a key (comma-separated), e.g.
# MOCK_PROVIDERS=seatgeek,ticketmaster
MOCK_PROVIDERS=

# ── Phase 2 — push + analytics ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Phase 3 — premium, SMS, errors, admin ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SENTRY_DSN=
ADMIN_EMAILS=
